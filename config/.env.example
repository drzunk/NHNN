# Sao chép file này thành config/.env rồi điền giá trị thật.
# KHÔNG commit file config/.env (đã có trong .gitignore).

# DVC-NHNN (He thong Mot cua & Giai quyet TTHC)
DVC_NHNN_BASE_URL=http://10.14.242.16:9292/Default.aspx?tabid=38
DVC_NHNN_CUCCNTT_USERNAME=CHANGE_ME
DVC_NHNN_CUCCNTT_PASSWORD=CHANGE_ME
DVC_NHNN_VUTCCB_USERNAME=CHANGE_ME
DVC_NHNN_VUTCCB_PASSWORD=CHANGE_ME

# true (mac dinh, nen dung khi chay CI/hang loat) hoac false (hien cua so
# Chrome that de quan sat truc tiep luc debug)
PW_HEADLESS=true

# true (mac dinh) = LoginBootstrapperApp thu tu doc captcha bang OCR truoc
# khi cho nguoi nhap tay (do chinh xac ~89% tren 9 mau da do, xem README).
# false = luon cho nhap tay.
CAPTCHA_OCR_ENABLED=true
